# API Configuration
NEXT_PUBLIC_API_URL=https://api.wind.network
NEXT_PUBLIC_DROPSPACE_API_URL=https://api.dropspace.wind.network

# Authentication
NEXT_PUBLIC_AUTH_DOMAIN=auth.wind.network

# WebSocket Configuration
NEXT_PUBLIC_WS_URL=wss://ws.wind.network

# Feature Flags
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_ENABLE_P2P=true

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=

# Environment
NEXT_PUBLIC_ENV=production